# Copy this file to .env and fill in real values before running the app
# or building/starting the Docker image.

# Django
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-value
ALLOWED_HOSTS=example.com,www.example.com
ENABLE_SILK=False

# Database - required when DEBUG=False (dev falls back to local sqlite)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://edupath:edupath@db:5432/edupath

# Redis - backs Celery (background jobs like AI document extraction)
REDIS_URL=redis://default:PASSWORD@HOST:PORT/0

# Gemini - used for AI document field extraction
GEMINI_API_KEY=
GEMINI_EXTRACTION_MODEL=gemini-flash-latest

# Gmail SMTP - deadline reminder emails. Use a Gmail App Password (not your
# normal password): https://myaccount.google.com/apppasswords
# Leave both blank to fall back to printing emails to the console instead.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
